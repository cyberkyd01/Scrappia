# Data directory (SQLite db, exports, browser profiles). Default: ~/.scrappia
SCRAPPIA_HOME=

# Log level: debug | info | warn | error
SCRAPPIA_LOG_LEVEL=info

# --- AI (optional). Configure providers in settings, or set one of these for auto-detection ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Local model via Ollama / LM Studio (OpenAI-compatible endpoint)
OLLAMA_HOST=
SCRAPPIA_AI_MODEL=

# --- Server ---
PORT=8788
HOST=0.0.0.0
# Bootstrap API key used until you create keys via the API/CLI
SCRAPPIA_API_KEY=
SCRAPPIA_CORS=*

# --- MCP over HTTP (optional) ---
SCRAPPIA_MCP_TOKEN=
